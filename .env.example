# =========================================
# Aplicação
# =========================================
NODE_ENV=development
PORT=3000
# Prefixo global das rotas HTTP (ex.: /api)
API_PREFIX=api

# =========================================
# Banco de dados (PostgreSQL / TypeORM)
# =========================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=app
# Sincroniza o schema automaticamente. NUNCA use true em produção — use migrations.
DB_SYNCHRONIZE=false
# Loga as queries SQL executadas
DB_LOGGING=false

# =========================================
# Cache (Redis)
# =========================================
REDIS_URL=redis://localhost:6379
# TTL padrão do cache em milissegundos (60000 = 60s)
CACHE_TTL=60000

# =========================================
# Autenticação
# =========================================
# Required — used by ApiKeyGuard to validate X-Api-Key requests
API_KEY=change-me

# =========================================
# Gemini / IA
# =========================================
# Required — obtain at https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
AI_TIMEOUT_MS=30000

# =========================================
# Limites de arquivo (MB)
# =========================================
AUDIO_MAX_SIZE_MB=25
IMAGE_MAX_SIZE_MB=10
PDF_MAX_SIZE_MB=20
